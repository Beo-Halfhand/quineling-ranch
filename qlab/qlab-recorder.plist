<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.qlab-recorder</string>
  <key>UserName</key><string>qlab</string>
  <key>ProgramArguments</key><array>
    <string>__QLAB_HOME__/opt/node/bin/node</string>
    <string>__QLAB_HOME__/lab/qlab-recorder.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__QLAB_HOME__</string>
  <key>StartInterval</key><integer>15</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__QLAB_HOME__/lab/kw/recorder.log</string>
  <key>StandardErrorPath</key><string>__QLAB_HOME__/lab/kw/recorder.log</string>
</dict></plist>
